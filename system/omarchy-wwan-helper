#!/bin/bash
# omarchy-wwan-helper — privileged WWAN operations for Omarchy.
#
# Omarchy runs systemd-networkd + iwd rather than NetworkManager. systemd 260
# added a native [MobileNetwork] section that drives ModemManager directly:
# networkd establishes the bearer and applies the addressing it hands back. So
# this helper does NOT configure IP itself — doing so would fight networkd.
#
# What is left for us is what [MobileNetwork] does not cover:
#   * generating that section from the user-facing ~/.config/omarchy/wwan.conf
#   * choosing the SIM slot (physical card vs built-in eSIM)
#   * the rfkill on/off switch
#
# Runs as root from omarchy-wwan.service. Users talk to it via `omarchy-wwan`.

set -uo pipefail

CONFIG="${OMARCHY_WWAN_CONFIG:-@CONFIG@}"
DROPIN_DIR=/etc/systemd/network/20-wwan.network.d
DROPIN="$DROPIN_DIR/10-omarchy-mobile.conf"

# Logs go to stderr: several helpers return values on stdout via $(...).
log() {
  echo "$*" >&2
  logger -t omarchy-wwan -- "$*" 2>/dev/null
}

die() {
  log "error: $*"
  exit 1
}

# Read a single KEY=VALUE from the config. The config is parsed rather than
# sourced: it lives in the user's home and root reads it.
cfg() {
  local key="$1" def="${2-}" v
  v=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=//p" "$CONFIG" 2>/dev/null | tail -1 |
    sed -e 's/[[:space:]]\+#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
      -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")
  printf '%s' "${v:-$def}"
}

# Pull one key out of `mmcli -K` output. Values may contain colons (IPv6), so
# match on the key half only and print the remainder verbatim.
kv() {
  awk -v key="$2" -F: '
    { k = $1; gsub(/[ \t]+$/, "", k)
      if (k == key) { sub(/^[^:]*:[ \t]*/, ""); if ($0 == "--") exit; print; exit } }
  ' <<<"$1"
}

modem_index() {
  mmcli -L -K 2>/dev/null | sed -n 's|.*/Modem/\([0-9]\+\).*|\1|p' | head -1
}

modem_dump() { mmcli -m "$1" -K 2>/dev/null; }

# The modem object disappears and comes back around slot switches and resets.
wait_for_modem() {
  local deadline=$((SECONDS + ${1:-30})) idx
  while ((SECONDS < deadline)); do
    idx=$(modem_index)
    [[ -n $idx ]] && {
      printf '%s' "$idx"
      return 0
    }
    sleep 1
  done
  return 1
}

modem_net_iface() {
  modem_dump "$1" |
    sed -n 's/^[[:space:]]*modem\.generic\.ports\.value\[[0-9]*\][[:space:]]*:[[:space:]]*\([^ ]*\) (net)$/\1/p' |
    head -1
}

wait_for_connected() {
  local idx="$1" deadline=$((SECONDS + ${2:-90})) state reg
  while ((SECONDS < deadline)); do
    state=$(kv "$(modem_dump "$idx")" modem.generic.state)
    [[ $state == connected ]] && return 0
    reg=$(kv "$(modem_dump "$idx")" modem.3gpp.registration-state)
    [[ $reg == denied ]] && die "network registration denied — check the SIM/subscription"
    sleep 2
  done
  return 1
}

# After suspend the DW5821e can come back without re-enumerating on USB.
# ModemManager then recreates the modem object without re-probing cdc-wdm0 and
# is left driving it over AT only ("could not grab port cdc-wdm0" in the log).
# An AT-only modem registers fine but can never raise a bearer, so `up` would
# sit out its whole timeout and fail. Detect the missing control port and reset
# the modem: the reset drops it off the bus and the re-enumeration makes
# ModemManager probe every port again, MBIM included.
has_control_port() {
  modem_dump "$1" | grep -qE '\((mbim|qmi)\)$'
}

ensure_control_port() {
  local idx="$1"

  if has_control_port "$idx"; then
    printf '%s' "$idx"
    return 0
  fi
  # No cdc-wdm node at all means this modem genuinely is AT-driven — not our
  # stale-resume case. Leave it alone.
  if ! compgen -G '/dev/cdc-wdm*' >/dev/null; then
    printf '%s' "$idx"
    return 0
  fi

  log "modem has no MBIM/QMI control port (stale state after resume) — resetting modem"
  mmcli -m "$idx" --reset >/dev/null 2>&1
  sleep 3
  idx=$(wait_for_modem 60) ||
    die "modem did not come back after reset — try: systemctl restart ModemManager"
  has_control_port "$idx" ||
    die "modem still has no control port after reset — try: systemctl restart ModemManager"

  log "modem re-probed with its control port back"
  printf '%s' "$idx"
}

select_sim_slot() {
  local idx="$1" want cur
  want=$(cfg SIM_SLOT)
  [[ -n $want ]] || return 0

  cur=$(kv "$(modem_dump "$idx")" modem.generic.primary-sim-slot)
  [[ -n $cur && $want != "$cur" ]] || return 0

  log "switching primary SIM slot $cur -> $want"
  if ! mmcli -m "$idx" --set-primary-sim-slot="$want" >/dev/null 2>&1; then
    log "warning: could not switch SIM slot, continuing with slot $cur"
    return 0
  fi
  # The modem re-enumerates after a slot switch.
  sleep 3
  idx=$(wait_for_modem 30) || die "modem did not come back after SIM slot switch"
  printf '%s' "$idx"
}

# Translate the friendly config into a networkd drop-in. Kept as a drop-in so
# Omarchy's own 20-wwan.network stays untouched and survives updates.
cmd_apply() {
  local apn family metric roaming pin user pass operator

  apn=$(cfg APN internet)
  metric=$(cfg ROUTE_METRIC 700)
  roaming=$(cfg ALLOW_ROAMING yes)
  pin=$(cfg PIN)
  user=$(cfg APN_USER)
  pass=$(cfg APN_PASS)
  operator=$(cfg OPERATOR_ID)

  case $(cfg IP_TYPE ipv4v6) in
  ipv4) family=ipv4 ;;
  ipv6) family=ipv6 ;;
  *) family=both ;;
  esac

  mkdir -p "$DROPIN_DIR"
  umask 077

  {
    echo "# Generated by omarchy-wwan-helper from $CONFIG — do not edit by hand."
    echo "# Change ~/.config/omarchy/wwan.conf, then run: omarchy-wwan apply"
    echo
    echo "[Link]"
    echo "# A missing SIM or no coverage must never hold up the boot."
    echo "RequiredForOnline=no"
    echo
    echo "[Network]"
    echo "# An LTE link is not Ethernet and gets its addressing from the bearer,"
    echo "# so the usual layer-2 machinery is only noise here."
    echo "LLDP=no"
    echo "LinkLocalAddressing=no"
    echo "IPv6AcceptRA=no"
    echo "DHCP=no"
    echo
    echo "[MobileNetwork]"
    echo "APN=$apn"
    echo "IPFamily=$family"
    echo "AllowRoaming=$roaming"
    echo "UseGateway=yes"
    echo "# Keep mobile data below ethernet (20) and Wi-Fi (600) so it is only"
    echo "# used when nothing better is available."
    echo "RouteMetric=$metric"
    [[ -n $pin ]] && echo "PIN=$pin"
    [[ -n $user ]] && echo "User=$user"
    [[ -n $pass ]] && echo "Password=$pass"
    [[ -n $operator ]] && echo "OperatorId=$operator"
  } >"$DROPIN"

  # systemd-networkd drops privileges to the systemd-network user, so a
  # root-only 0600 file would be silently unreadable — and an unreadable drop-in
  # invalidates the whole .network, leaving the interface unmanaged.
  if getent group systemd-network >/dev/null 2>&1; then
    chown root:systemd-network "$DROPIN"
    chmod 640 "$DROPIN"
  else
    chmod 644 "$DROPIN"
  fi

  networkctl reload >/dev/null 2>&1
  log "applied APN=$apn metric=$metric family=$family"
}

cmd_up() {
  local idx new_idx ifc

  cmd_apply
  rfkill unblock wwan

  idx=$(wait_for_modem 45) || die "no WWAN modem found (is the card enabled in BIOS?)"
  mmcli -m "$idx" --set-power-state-on >/dev/null 2>&1

  idx=$(ensure_control_port "$idx") || exit 1

  new_idx=$(select_sim_slot "$idx")
  [[ -n $new_idx ]] && idx=$new_idx

  # Harmless if networkd's integration already did it, and makes the flow
  # deterministic if it only acts on an already-enabled modem.
  mmcli -m "$idx" --enable >/dev/null 2>&1

  # Nudge networkd to act on [MobileNetwork] now rather than on the next event.
  ifc=$(modem_net_iface "$idx")
  [[ -n $ifc ]] && networkctl reconfigure "$ifc" >/dev/null 2>&1

  log "waiting for systemd-networkd to bring up the bearer"
  wait_for_connected "$idx" 90 ||
    die "modem did not connect — check coverage, the SIM slot, and the APN in $CONFIG"

  log "connected${ifc:+ on $ifc}"
}

cmd_down() {
  local idx
  idx=$(modem_index)
  [[ -n $idx ]] && mmcli -m "$idx" --simple-disconnect >/dev/null 2>&1

  # rfkill is the honest off switch: it also stops networkd from reconnecting,
  # and systemd-rfkill remembers the state across reboots.
  rfkill block wwan
  log "disconnected"
}

case "${1:-}" in
up) cmd_up ;;
down) cmd_down ;;
apply) cmd_apply ;;
*)
  echo "usage: omarchy-wwan-helper {up|down|apply}" >&2
  exit 2
  ;;
esac
