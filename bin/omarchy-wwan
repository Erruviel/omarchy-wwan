#!/bin/bash
# omarchy:summary=Control the WWAN (mobile broadband) modem.
#
# User-facing front end for Omarchy's WWAN support. Read-only queries go
# straight to ModemManager; anything privileged is delegated to
# omarchy-wwan.service.

set -uo pipefail

CONFIG="$HOME/.config/omarchy/wwan.conf"
UNIT=omarchy-wwan.service
DROPIN=/etc/systemd/network/20-wwan.network.d/10-omarchy-mobile.conf
# read_state reuses STATE for the modem state, so the directory gets its own
# name; keep both pointing at the same place.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-wwan"
STATE_DIR=$STATE
USAGE_FILE="$STATE_DIR/usage"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/erruviel.wwan"

# Where to point the user for repairs: an explicit override, then the shell
# plugin copy (what `omarchy plugin add` leaves behind), then the dev checkout.
if [[ -n ${OMARCHY_WWAN_REPO:-} ]]; then
  REPO_HINT=$OMARCHY_WWAN_REPO
elif [[ -x $PLUGIN_DIR/install.sh ]]; then
  REPO_HINT=$PLUGIN_DIR
else
  REPO_HINT="$HOME/Projects/omarchy-wwan"
fi

kv() {
  awk -v key="$2" -F: '
    { k = $1; gsub(/[ \t]+$/, "", k)
      if (k == key) { sub(/^[^:]*:[ \t]*/, ""); if ($0 == "--") exit; print; exit } }
  ' <<<"$1"
}

modem_index() {
  mmcli -L -K 2>/dev/null | sed -n 's|.*/Modem/\([0-9]\+\).*|\1|p' | head -1
}

notify() { notify-send -u low "Mobile data" "$1" 2>/dev/null; }

get_cfg() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=//p" "$CONFIG" 2>/dev/null | tail -1 |
    sed -e 's/[[:space:]]\+#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

set_cfg() {
  local key="$1" val="$2"
  if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG" 2>/dev/null; then
    sed -i "s|^[[:space:]]*${key}[[:space:]]*=.*|${key}=${val}|" "$CONFIG"
  else
    printf '%s=%s\n' "$key" "$val" >>"$CONFIG"
  fi
}

# Collapses the modem into one of: absent, disabled, searching, registered,
# connected — plus operator, access technology and signal strength.
# Exact field match: "unblocked" contains "blocked" as a substring, so a naive
# grep reports every working modem as switched off.
wwan_blocked() {
  rfkill --output SOFT --noheadings list wwan 2>/dev/null |
    awk '$1 == "blocked" { found = 1 } END { exit !found }'
}

# `absent` from mmcli does not mean "no WWAN card": ModemManager needs upwards
# of a minute to probe the ports at boot, and the modem object briefly vanishes
# around suspend and SIM-slot switches. rfkill and sysfs still see the hardware
# through all of that, so use them to tell "not probed yet" from "no card".
wwan_hw_present() {
  [[ -n $(rfkill list wwan 2>/dev/null) ]] && return 0
  compgen -G '/sys/class/net/ww*' >/dev/null && return 0
  compgen -G '/dev/cdc-wdm*' >/dev/null
}

read_state() {
  STATE=absent OPERATOR="" TECH="" SIGNAL=0 IFACE="" IPADDR="" ACTIVE_SLOT=""
  SLOT1_SIM="" SLOT2_SIM=""

  # A soft-blocked radio is a deliberate "off", not a modem that is missing or
  # hunting for a network — and while blocked the modem may vanish from mmcli.
  if wwan_blocked; then
    STATE=disabled
    return 0
  fi

  local idx dump
  idx=$(modem_index)
  [[ -n $idx ]] || return 0
  MODEM=$idx

  dump=$(mmcli -m "$idx" -K 2>/dev/null)
  OPERATOR=$(kv "$dump" modem.3gpp.operator-name)
  # access-technologies is a list, even when the modem reports just one.
  TECH=$(kv "$dump" "modem.generic.access-technologies.value[1]" | tr '[:lower:]' '[:upper:]')
  SIGNAL=$(kv "$dump" modem.generic.signal-quality.value)
  SIGNAL=${SIGNAL:-0}

  local mstate reg
  mstate=$(kv "$dump" modem.generic.state)
  reg=$(kv "$dump" modem.3gpp.registration-state)

  # Which slots actually hold a SIM. An empty slot reports the path "/";
  # the panel uses this to mark a blank eSIM before anyone clicks it.
  local p1 p2
  p1=$(kv "$dump" "modem.generic.sim-slots.value[1]")
  p2=$(kv "$dump" "modem.generic.sim-slots.value[2]")
  [[ -n $p1 ]] && { [[ $p1 == / ]] && SLOT1_SIM=no || SLOT1_SIM=yes; }
  [[ -n $p2 ]] && { [[ $p2 == / ]] && SLOT2_SIM=no || SLOT2_SIM=yes; }

  # An empty active SIM slot reports the path "/" — a blank eSIM, typically.
  # The modem then hunts for a network forever, which looks exactly like poor
  # coverage; say what is actually wrong instead of "searching".
  local pslot spath
  pslot=$(kv "$dump" modem.generic.primary-sim-slot)
  if [[ $pslot =~ ^[0-9]+$ && $mstate != connected ]]; then
    spath=$(kv "$dump" "modem.generic.sim-slots.value[$pslot]")
    if [[ $spath == / ]]; then
      STATE=nosim
      ACTIVE_SLOT=$pslot
      return 0
    fi
  fi

  case $mstate in
  connected)
    STATE=connected
    IFACE=$(sed -n 's/^[[:space:]]*modem\.generic\.ports\.value\[[0-9]*\][[:space:]]*:[[:space:]]*\([^ ]*\) (net)$/\1/p' <<<"$dump" | head -1)
    [[ -n $IFACE ]] && IPADDR=$(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}')
    ;;
  registered | disconnecting | connecting) STATE=registered ;;
  enabled | searching)
    [[ $reg == home || $reg == roaming ]] && STATE=registered || STATE=searching
    ;;
  locked) STATE=locked ;;
  *) STATE=disabled ;;
  esac
}

# Always a cellular-bars glyph, so the icon's shape never changes — only how many
# bars are filled. States that carry no signal show the empty outline and get
# dimmed by CSS instead of switching to a different symbol.
#
#   U+F08BF md-signal_cellular_outline   empty
#   U+F08BC md-signal_cellular_1         1/3
#   U+F08BD md-signal_cellular_2         2/3
#   U+F08BE md-signal_cellular_3         full
signal_icon() {
  case $STATE in
  absent | disabled | locked | searching | nosim) printf '\U000F08BF' ;;
  *)
    if ((SIGNAL >= 67)); then printf '\U000F08BE'
    elif ((SIGNAL >= 34)); then printf '\U000F08BD'
    elif ((SIGNAL > 0)); then printf '\U000F08BC'
    else printf '\U000F08BF'
    fi
    ;;
  esac
}

cmd_status() {
  read_state
  case $STATE in
  absent)
    echo "No WWAN modem detected."
    return 1
    ;;
  disabled) echo "Mobile data: off" ;;
  nosim)
    if [[ $ACTIVE_SLOT == 2 ]]; then
      echo "Mobile data: the eSIM (slot 2) is empty — no profile is installed on it."
      echo "  Install one with an LPA client (e.g. lpac), or switch back: omarchy-wwan sim 1"
    else
      echo "Mobile data: SIM slot ${ACTIVE_SLOT:-?} is empty — insert a card or switch slots."
    fi
    ;;
  locked) echo "Mobile data: SIM locked (PIN required)" ;;
  searching) echo "Mobile data: searching for network (signal ${SIGNAL}%)" ;;
  registered) echo "Mobile data: registered on ${OPERATOR:-unknown}, not connected (signal ${SIGNAL}%)" ;;
  connected)
    echo "Mobile data: connected"
    echo "  operator:  ${OPERATOR:-unknown}"
    echo "  technology: ${TECH:-unknown}"
    echo "  signal:    ${SIGNAL}%"
    echo "  interface: ${IFACE:-unknown}${IPADDR:+  ($IPADDR)}"
    ;;
  esac
  return 0
}

# Waybar-style JSON status: {text, tooltip, class, percentage}. Consumed by
# the shell bar widget (shell/BarWidget.qml); the format predates it — it is
# what the waybar module ate in Omarchy 3, and there was no reason to change.
cmd_json() {
  read_state
  # The bar polls this every few seconds, which makes it the data meter's
  # heartbeat: usage accrues and the limit is enforced on every poll.
  meter_update
  # Empty text hides the module entirely — but only on machines with no modem.
  # A card that merely has not been probed yet keeps its spot in the bar, or
  # the icon would blink out at every boot and resume.
  if [[ $STATE == absent ]]; then
    if wwan_hw_present; then
      printf '{"text":"\U000F08BF","tooltip":"Modem starting…","class":"searching","percentage":0}\n'
    else
      echo '{"text":"","tooltip":"","class":"absent"}'
    fi
    return 0
  fi

  local tooltip
  case $STATE in
  disabled)
    if ((LIMIT_BYTES > 0 && USED_BYTES >= LIMIT_BYTES)); then
      tooltip="Data limit reached — mobile data off"
    else
      tooltip="Mobile data off"
    fi
    ;;
  locked) tooltip="SIM locked — PIN required" ;;
  nosim)
    if [[ $ACTIVE_SLOT == 2 ]]; then
      tooltip="eSIM is empty — no profile installed"
    else
      tooltip="SIM slot ${ACTIVE_SLOT:-?} is empty"
    fi
    ;;
  searching) tooltip="Searching for network" ;;
  registered) tooltip="${OPERATOR:-Registered} — not connected" ;;
  connected) tooltip="${OPERATOR:-Connected}${TECH:+ · $TECH} · ${SIGNAL}%${IPADDR:+\\n$IPADDR}" ;;
  esac

  printf '{"text":"%s","tooltip":"%s","class":"%s","percentage":%s}\n' \
    "$(signal_icon)" "$tooltip" "$STATE" "${SIGNAL:-0}"
}

# ------------------------------------------------------------- data limit
#
# Kernel byte counters vanish on reboot and interface re-creation, so usage
# is accumulated into $USAGE_FILE as deltas between successive samples. The
# meter runs on every bar poll (~10s), which also makes it the enforcement
# point: reach the limit and mobile data is cut off with a notification.

# DATA_LIMIT accepts 5G / 1.5G / 500M / 500MB / off. Prints bytes, 0 = off.
limit_bytes() {
  local v
  v=$(get_cfg DATA_LIMIT)
  [[ -n $v && ${v,,} != off ]] || {
    echo 0
    return
  }
  awk -v s="$v" 'BEGIN {
    n = s
    sub(/[GgMmKk][Bb]?$/, "", n)
    if (n !~ /^[0-9]+(\.[0-9]+)?$/) { print 0; exit }
    u = toupper(substr(s, length(n) + 1, 1))
    m = 0
    if (u == "G") m = 1024 ^ 3
    else if (u == "M") m = 1024 ^ 2
    else if (u == "K") m = 1024
    printf "%.0f", n * m
  }'
}

fmt_bytes() {
  awk -v n="$1" 'BEGIN {
    if (n < 1024) printf "%d B", n
    else if (n < 1024 ^ 2) printf "%.1f KB", n / 1024
    else if (n < 1024 ^ 3) printf "%.1f MB", n / 1024 ^ 2
    else printf "%.2f GB", n / 1024 ^ 3
  }'
}

# Renewal day 31 in a 30-day month lands on the month's last day.
clamp_day() { # <YYYY-MM> <day>
  local dim=$(date -d "$1-01 +1 month -1 day" +%-d) d=$2
  ((d > dim)) && d=$dim
  printf '%s-%02d' "$1" "$d"
}

# Sets PERIOD_START and PERIOD_NEXT (both YYYY-MM-DD) for the current
# billing period: the day the package renews each month, or midnight for
# daily plans. ISO dates compare correctly as strings.
period_bounds() {
  local period day ym start
  period=$(get_cfg DATA_PERIOD)
  if [[ ${period:-monthly} == daily ]]; then
    PERIOD_START=$(date +%F)
    PERIOD_NEXT=$(date -d tomorrow +%F)
    return
  fi
  day=$(get_cfg DATA_RESET_DAY)
  [[ $day =~ ^[0-9]+$ ]] || day=1
  ((day < 1)) && day=1
  ((day > 31)) && day=31
  ym=$(date +%Y-%m)
  start=$(clamp_day "$ym" "$day")
  if [[ $(date +%F) < $start ]]; then
    PERIOD_START=$(clamp_day "$(date -d "$ym-01 -1 month" +%Y-%m)" "$day")
    PERIOD_NEXT=$start
  else
    PERIOD_START=$start
    PERIOD_NEXT=$(clamp_day "$(date -d "$ym-01 +1 month" +%Y-%m)" "$day")
  fi
}

meter_iface() {
  [[ -n ${IFACE:-} ]] && {
    echo "$IFACE"
    return 0
  }
  local i
  for i in /sys/class/net/ww*; do
    [[ -e $i ]] && {
      basename "$i"
      return 0
    }
  done
  return 1
}

# Accumulate usage and enforce the limit. Sets USED_BYTES, LIMIT_BYTES,
# LIMIT_ACK. Expects read_state to have run (uses the modem STATE/IFACE).
meter_update() {
  local iface cur_rx cur_tx d_rx d_tx have_state=0
  local u_start="" u_rx=0 u_tx=0 u_lrx=0 u_ltx=0 u_ack=0
  mkdir -p "$STATE_DIR"
  period_bounds

  if [[ -r $USAGE_FILE ]]; then
    have_state=1
    while IFS='=' read -r k v; do
      case $k in
      period_start) u_start=$v ;;
      rx) u_rx=$v ;;
      tx) u_tx=$v ;;
      last_rx) u_lrx=$v ;;
      last_tx) u_ltx=$v ;;
      ack) u_ack=$v ;;
      esac
    done <"$USAGE_FILE"
  fi

  # The package renewed: usage starts over, and so does the cutoff. Counter
  # snapshots are kept — the kernel counters did not reset with the period.
  if [[ $u_start != "$PERIOD_START" ]]; then
    u_rx=0 u_tx=0 u_ack=0
  fi

  if iface=$(meter_iface) && [[ -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
    cur_rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
    cur_tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes")
    if ((have_state)); then
      # A counter below the last snapshot means the netdev was re-created
      # (reboot, replug, suspend): everything on it is new traffic.
      ((cur_rx >= u_lrx)) && d_rx=$((cur_rx - u_lrx)) || d_rx=$cur_rx
      ((cur_tx >= u_ltx)) && d_tx=$((cur_tx - u_ltx)) || d_tx=$cur_tx
      u_rx=$((u_rx + d_rx))
      u_tx=$((u_tx + d_tx))
    fi
    # First run only snapshots — the counters may hold traffic from before
    # the meter existed, and charging that would overcount.
    u_lrx=$cur_rx
    u_ltx=$cur_tx
  fi

  printf 'period_start=%s\nrx=%s\ntx=%s\nlast_rx=%s\nlast_tx=%s\nack=%s\n' \
    "$PERIOD_START" "$u_rx" "$u_tx" "$u_lrx" "$u_ltx" "$u_ack" >"$USAGE_FILE"

  USED_BYTES=$((u_rx + u_tx))
  LIMIT_BYTES=$(limit_bytes)
  LIMIT_ACK=$u_ack

  if ((LIMIT_BYTES > 0 && USED_BYTES >= LIMIT_BYTES && LIMIT_ACK == 0)) &&
    [[ ${STATE:-} == connected ]]; then
    if systemctl stop "$UNIT" 2>/dev/null; then
      omarchy-notification-send -g "󰢿" -u critical "Data limit reached" \
        "Used $(fmt_bytes "$USED_BYTES") of $(fmt_bytes "$LIMIT_BYTES") — mobile data disconnected. Reconnect manually to keep using data this period." 2>/dev/null ||
        notify "Data limit reached — mobile data disconnected"
      STATE=disabled
    fi
  fi
}

cmd_limit() {
  case "${1:-}" in
  "")
    read_state
    meter_update
    period_bounds
    if ((LIMIT_BYTES > 0)); then
      echo "Data limit:  $(get_cfg DATA_LIMIT) ($(fmt_bytes "$LIMIT_BYTES"))"
    else
      echo "Data limit:  off"
    fi
    echo "Period:      $(get_cfg DATA_PERIOD | grep . || echo monthly), started $PERIOD_START, resets $PERIOD_NEXT"
    echo "Used:        $(fmt_bytes "$USED_BYTES")"
    if ((LIMIT_ACK)); then
      echo "Note:        limit reached and overridden — no auto-cutoff until the period resets"
    fi
    ;;
  off) set_cfg DATA_LIMIT off && echo "Data limit disabled." ;;
  day)
    [[ ${2:-} =~ ^[0-9]+$ ]] && ((10#$2 >= 1 && 10#$2 <= 31)) || {
      echo "usage: omarchy-wwan limit day <1-31>" >&2
      return 2
    }
    set_cfg DATA_RESET_DAY "$2" && echo "Package renews on day $2 of the month."
    ;;
  period)
    [[ ${2:-} == monthly || ${2:-} == daily ]] || {
      echo "usage: omarchy-wwan limit period {monthly|daily}" >&2
      return 2
    }
    set_cfg DATA_PERIOD "$2" && echo "Billing period set to $2."
    ;;
  reset)
    rm -f "$USAGE_FILE"
    echo "Usage counter reset."
    ;;
  *)
    if [[ $(limit_bytes_probe "${1:-}") -gt 0 ]]; then
      set_cfg DATA_LIMIT "$1"
      echo "Data limit set to $1."
    else
      cat >&2 <<'EOF'
usage: omarchy-wwan limit [command]

  (no args)             show limit, period and usage
  <size>                set the limit, e.g. 5G, 1.5G, 500M
  off                   disable the limit (usage is still tracked)
  day <1-31>            day of the month the package renews
  period monthly|daily  billing period
  reset                 zero the usage counter (e.g. after buying extra data)
EOF
      return 2
    fi
    ;;
  esac
}

# Validate a size argument without touching the config.
limit_bytes_probe() {
  awk -v s="${1:-}" 'BEGIN {
    n = s
    sub(/[GgMmKk][Bb]?$/, "", n)
    if (n !~ /^[0-9]+(\.[0-9]+)?$/ || n == s) { print 0; exit }
    u = toupper(substr(s, length(n) + 1, 1))
    m = 0
    if (u == "G") m = 1024 ^ 3
    else if (u == "M") m = 1024 ^ 2
    else if (u == "K") m = 1024
    printf "%.0f", n * m
  }'
}

# Menu-driven setup: period → size → renewal day, all via the Omarchy menu.
cmd_limit_input() {
  local choice size day
  choice=$(omarchy-menu-select "Data limit" "Monthly limit" "Daily limit" "Turn off limit") || return 0
  case $choice in
  "Turn off limit")
    set_cfg DATA_LIMIT off
    notify "Data limit disabled"
    return 0
    ;;
  "Monthly limit") set_cfg DATA_PERIOD monthly ;;
  "Daily limit") set_cfg DATA_PERIOD daily ;;
  *) return 0 ;;
  esac

  size=$(omarchy-menu-input "Limit (e.g. 5G or 500M)") || return 0
  [[ -n $size ]] || return 0
  if [[ $(limit_bytes_probe "$size") -eq 0 ]]; then
    notify "Not a valid limit: $size (try 5G or 500M)"
    return 1
  fi
  set_cfg DATA_LIMIT "$size"

  if [[ $choice == "Monthly limit" ]]; then
    day=$(omarchy-menu-input "Renewal day of month (1-31)") || return 0
    if [[ $day =~ ^[0-9]+$ ]] && ((10#$day >= 1 && 10#$day <= 31)); then
      set_cfg DATA_RESET_DAY "$day"
    elif [[ -n $day ]]; then
      notify "Renewal day must be 1-31 — kept $(get_cfg DATA_RESET_DAY | grep . || echo 1)"
    fi
  fi

  period_bounds
  notify "Data limit: $size, resets $PERIOD_NEXT"
}

# Everything the shell panel needs in one process spawn: modem state, config
# and unit status as key=value lines. Values are single-line by construction
# (mmcli/config fields), so no quoting is needed.
cmd_panel() {
  read_state
  meter_update
  printf 'state=%s\n' "$STATE"
  printf 'operator=%s\n' "$OPERATOR"
  printf 'tech=%s\n' "$TECH"
  printf 'signal=%s\n' "$SIGNAL"
  printf 'iface=%s\n' "$IFACE"
  printf 'ip=%s\n' "$IPADDR"
  printf 'icon=%s\n' "$(signal_icon)"
  printf 'active_slot=%s\n' "$ACTIVE_SLOT"
  printf 'slot1_sim=%s\n' "$SLOT1_SIM"
  printf 'slot2_sim=%s\n' "$SLOT2_SIM"
  printf 'slot=%s\n' "$(get_cfg SIM_SLOT)"
  printf 'apn=%s\n' "$(get_cfg APN)"
  if systemctl is-enabled --quiet "$UNIT" 2>/dev/null; then
    printf 'autoconnect=yes\n'
  else
    printf 'autoconnect=no\n'
  fi
  if systemctl cat "$UNIT" >/dev/null 2>&1; then
    printf 'installed=yes\n'
  else
    printf 'installed=no\n'
  fi
  if wwan_hw_present; then
    printf 'hw=yes\n'
  else
    printf 'hw=no\n'
  fi

  printf 'used_bytes=%s\n' "$USED_BYTES"
  printf 'limit_bytes=%s\n' "$LIMIT_BYTES"
  printf 'limit=%s\n' "$(get_cfg DATA_LIMIT)"
  printf 'period=%s\n' "$(get_cfg DATA_PERIOD | grep . || echo monthly)"
  printf 'next_reset=%s\n' "$PERIOD_NEXT"
  printf 'limit_ack=%s\n' "$LIMIT_ACK"

  # Traffic and latency cost real time (the ping alone can burn its full 1s
  # timeout), so they are opt-in: the open panel polls --verbose, the bar's
  # background poll stays on the cheap form.
  if [[ ${1:-} == --verbose && -n $IFACE ]]; then
    [[ -r /sys/class/net/$IFACE/statistics/rx_bytes ]] &&
      printf 'rx_bytes=%s\n' "$(cat "/sys/class/net/$IFACE/statistics/rx_bytes")"
    [[ -r /sys/class/net/$IFACE/statistics/tx_bytes ]] &&
      printf 'tx_bytes=%s\n' "$(cat "/sys/class/net/$IFACE/statistics/tx_bytes")"
    # Bind to the modem's interface: the default route is usually Wi-Fi, and
    # an unbound ping would measure the wrong link entirely. An empty value is
    # a timeout — the panel counts those as packet loss.
    if [[ $STATE == connected ]] && command -v ping >/dev/null; then
      printf 'ping_ms=%s\n' "$(LC_ALL=C ping -n -c 1 -W 1 -I "$IFACE" 1.1.1.1 2>/dev/null |
        awk -F'time[=<]' '/time[=<]/ { split($2, parts, " "); print parts[1]; exit }')"
    fi
  fi
}

# The privileged half lives in a systemd unit; without it nothing can connect.
require_system_half() {
  systemctl cat "$UNIT" >/dev/null 2>&1 && return 0
  echo "The system-side WWAN support is not installed yet." >&2
  echo "Run once:  $REPO_HINT/install.sh" >&2
  notify "Not installed — run: $REPO_HINT/install.sh"
  return 1
}

cmd_connect() {
  require_system_half || return 1
  # Connecting while over the limit is a deliberate act: honor it, and stop
  # the meter from cutting the connection right back off. The override lasts
  # until the period resets.
  read_state
  meter_update
  if ((LIMIT_BYTES > 0 && USED_BYTES >= LIMIT_BYTES && LIMIT_ACK == 0)); then
    sed -i 's/^ack=.*/ack=1/' "$USAGE_FILE"
    notify "Over the data limit ($(fmt_bytes "$USED_BYTES") used) — auto-cutoff disabled until the period resets"
  fi
  notify "Connecting…"
  if systemctl start "$UNIT"; then
    read_state
    notify "Connected to ${OPERATOR:-mobile network}"
  else
    notify "Connection failed — see: journalctl -u $UNIT"
    return 1
  fi
}

cmd_disconnect() {
  systemctl stop "$UNIT" && notify "Disconnected"
}

cmd_toggle() {
  read_state
  if [[ $STATE == connected ]]; then cmd_disconnect; else cmd_connect; fi
}

cmd_sim() {
  local slot="${1:-}"
  case $slot in
  # Bare `sim` prints the configured slot — the menu's ✓ marks read this, so
  # it must stay cheap (no mmcli round-trip).
  "") get_cfg SIM_SLOT; return 0 ;;
  1 | physical) slot=1 ;;
  2 | esim) slot=2 ;;
  *)
    echo "usage: omarchy-wwan sim [1|2]   (1 = physical card, 2 = eSIM)" >&2
    return 2
    ;;
  esac

  # Refuse to switch onto a slot with no SIM in it. The modem cannot connect
  # to anything there, and the attempt would hang the unit (and the panel's
  # buttons with it) for minutes before failing.
  local idx spath
  idx=$(modem_index)
  if [[ -n $idx ]]; then
    spath=$(kv "$(mmcli -m "$idx" -K 2>/dev/null)" "modem.generic.sim-slots.value[$slot]")
    if [[ $spath == / ]]; then
      if [[ $slot == 2 ]]; then
        echo "The eSIM (slot 2) is empty — no profile is installed on it. Not switching." >&2
        echo "Install a profile with an LPA client (e.g. lpac) first." >&2
        notify "eSIM is empty — no profile installed. Not switching."
      else
        echo "SIM slot $slot is empty — insert a card first. Not switching." >&2
        notify "SIM slot $slot is empty — not switching"
      fi
      return 1
    fi
  fi

  set_cfg SIM_SLOT "$slot"

  # SetPrimarySimSlot is not on ModemManager's D-Bus whitelist, so it is
  # root-only no matter what polkit says — the bus rejects the message before
  # polkit is ever consulted. Let the helper do it from the unit.
  if systemctl cat "$UNIT" >/dev/null 2>&1; then
    echo "Switching to SIM slot $slot (this reconnects the modem)…"
    if systemctl restart "$UNIT"; then
      read_state
      notify "SIM slot $slot active — ${OPERATOR:-connected}"
      cmd_status
    else
      # The slot may well have switched — the *connect* after it is what
      # failed. An empty slot (blank eSIM) is the usual reason; say that
      # instead of a generic failure, and notify for panel/menu clicks.
      read_state
      if [[ $STATE == nosim ]]; then
        cmd_status
        if [[ $ACTIVE_SLOT == 2 ]]; then
          notify "eSIM is empty — no profile installed. Mobile data stays off until you switch back or install one."
        else
          notify "SIM slot ${ACTIVE_SLOT:-$slot} is empty"
        fi
        return 1
      fi
      echo "Slot switch failed — see: omarchy-wwan log" >&2
      notify "SIM slot switch failed — see: omarchy-wwan log"
      return 1
    fi
  else
    echo "Saved SIM_SLOT=$slot. Run 'omarchy-wwan apply' to switch."
  fi
}

# Carrier settings come from the mobile-broadband-provider-info database — the
# same one NetworkManager's mobile broadband wizard uses.
PROVIDERS=omarchy-wwan-providers

carrier_write() { # <apn> <label> <user> <password> <provider>
  set_cfg APN "$1"
  set_cfg APN_USER "$3"
  set_cfg APN_PASS "$4"

  echo "Carrier:  $5"
  echo "APN:      $1${2:+  ($2)}"
  [[ -n $3 ]] && echo "Username: $3"
  echo
  echo "Run 'omarchy-wwan apply' to activate it."
}

carrier_auto() {
  local idx code mcc mnc row cc country provider apn

  idx=$(modem_index)
  [[ -n $idx ]] || {
    echo "No modem detected." >&2
    return 1
  }

  code=$(kv "$(mmcli -m "$idx" -K 2>/dev/null)" modem.3gpp.operator-code)
  [[ -n $code ]] || {
    echo "The modem has not registered on a network yet, so there is no operator" >&2
    echo "code to look up. Pick the carrier by hand instead:" >&2
    echo "    omarchy-wwan carrier list" >&2
    return 1
  }

  # An operator code is MCC (always 3 digits) followed by a 2- or 3-digit MNC.
  mcc=${code:0:3}
  mnc=${code:3}

  row=$($PROVIDERS lookup "$mcc" "$mnc") || return 1
  IFS=$'\t' read -r cc country provider <<<"$row"

  apn=$($PROVIDERS apns "$cc" "$provider" | head -1)
  [[ -n $apn ]] || {
    echo "$provider ($country) has no data APN in the database." >&2
    return 1
  }

  echo "Detected $provider in $country (MCC $mcc, MNC $mnc)."
  IFS=$'\t' read -r value label user password <<<"$apn"
  carrier_write "$value" "$label" "$user" "$password" "$provider"
}

# Apply the config and report via notifications — the menu-driven flows run
# detached from any terminal, so stdout has nowhere to go.
apply_gui() {
  if ! systemctl cat "$UNIT" >/dev/null 2>&1; then
    notify "Saved. System side not installed — run: $REPO_HINT/install.sh"
    return 1
  fi
  notify "Applying carrier settings…"
  if systemctl restart "$UNIT"; then
    read_state
    notify "Connected to ${OPERATOR:-mobile network}"
  else
    notify "Reconnect failed — see: omarchy-wwan log"
    return 1
  fi
}

# Country → carrier → APN picker built on the Omarchy menu (quattro's
# omarchy-menu-select). Replaces the walker-based wizard from Omarchy 3.
carrier_choose() {
  local rows country cc provider apn_rows row choice
  rows=$(omarchy-wwan-providers countries) || return 1

  local names=()
  mapfile -t names < <(cut -f2 <<<"$rows")
  country=$(omarchy-menu-select "Country" "${names[@]}" -- --width 400) || return 0
  [[ -n $country ]] || return 0
  cc=$(awk -F'\t' -v n="$country" '$2 == n { print $1; exit }' <<<"$rows")

  local provs=()
  mapfile -t provs < <(omarchy-wwan-providers providers "$cc")
  ((${#provs[@]})) || return 1
  provider=$(omarchy-menu-select "Carrier in $country" "${provs[@]}" -- --width 400) || return 0
  [[ -n $provider ]] || return 0

  apn_rows=$(omarchy-wwan-providers apns "$cc" "$provider")
  if [[ -z $apn_rows ]]; then
    notify "$provider has no data APN in the database"
    return 1
  fi

  # Most carriers publish exactly one data APN — do not make the user confirm it.
  if [[ $(wc -l <<<"$apn_rows") -eq 1 ]]; then
    row=$apn_rows
  else
    local opts=()
    mapfile -t opts < <(awk -F'\t' '{ print ($2 == "" ? $1 : $1 "  —  " $2) }' <<<"$apn_rows")
    choice=$(omarchy-menu-select "APN for $provider" "${opts[@]}" -- --width 500) || return 0
    [[ -n $choice ]] || return 0
    row=$(awk -F'\t' -v v="${choice%%  —  *}" '$1 == v { print; exit }' <<<"$apn_rows")
  fi

  local value label user password
  IFS=$'\t' read -r value label user password <<<"$row"
  set_cfg APN "$value"
  set_cfg APN_USER "$user"
  set_cfg APN_PASS "$password"
  notify "Carrier set: $provider — APN $value"
  apply_gui
}

cmd_apn_input() {
  local apn
  apn=$(omarchy-menu-input "APN") || return 0
  [[ -n $apn ]] || return 0
  set_cfg APN "$apn"
  notify "APN set to $apn"
  apply_gui
}

cmd_notify_status() {
  local body
  body=$(cmd_status 2>&1)
  omarchy-notification-send -g "󰢾" "Mobile data" "$body" 2>/dev/null ||
    notify "$body"
}

cmd_carrier() {
  case "${1:-}" in
  auto | detect) carrier_auto ;;
  choose) carrier_choose ;;
  list)
    if [[ -z ${2:-} ]]; then
      $PROVIDERS countries
    elif [[ -z ${3:-} ]]; then
      $PROVIDERS providers "$2"
    else
      $PROVIDERS apns "$2" "$3"
    fi
    ;;
  set)
    [[ -n ${2:-} && -n ${3:-} ]] || {
      echo "usage: omarchy-wwan carrier set <country-code> <provider> [apn]" >&2
      return 2
    }
    local rows row
    rows=$($PROVIDERS apns "$2" "$3") || return 1
    if [[ -n ${4:-} ]]; then
      row=$(awk -F'\t' -v want="$4" '$1 == want { print; exit }' <<<"$rows")
      [[ -n $row ]] || {
        echo "$3 has no APN '$4'. Available:" >&2
        cut -f1 <<<"$rows" >&2
        return 1
      }
    else
      row=$(head -1 <<<"$rows")
    fi
    local value label user password
    IFS=$'\t' read -r value label user password <<<"$row"
    carrier_write "$value" "$label" "$user" "$password" "$3"
    ;;
  *)
    cat >&2 <<'EOF'
usage: omarchy-wwan carrier <command>

  auto                          detect the carrier from the SIM and set its APN
  choose                        pick country/carrier/APN via the Omarchy menu
  list                          list countries
  list <cc>                     list carriers in that country
  list <cc> <provider>          list that carrier's data APNs
  set <cc> <provider> [apn]     apply a carrier's APN settings

Examples:
  omarchy-wwan carrier auto
  omarchy-wwan carrier list pl
  omarchy-wwan carrier set pl Orange
EOF
    return 2
    ;;
  esac
}

cmd_autoconnect() {
  case "${1:-}" in
  on)
    set_cfg AUTOCONNECT yes
    systemctl enable "$UNIT" && echo "Autoconnect enabled."
    ;;
  off)
    set_cfg AUTOCONNECT no
    systemctl disable "$UNIT" && echo "Autoconnect disabled."
    ;;
  toggle)
    if systemctl is-enabled --quiet "$UNIT" 2>/dev/null; then
      cmd_autoconnect off && notify "Autoconnect disabled"
    else
      cmd_autoconnect on && notify "Autoconnect enabled"
    fi
    ;;
  *)
    systemctl is-enabled "$UNIT"
    ;;
  esac
}

# Verifies every piece the installer put in place. An Omarchy update or an
# `omarchy refresh shell` can quietly undo some of them, so this is what the
# post-update hook runs. Exits non-zero when anything needs attention.
cmd_doctor() {
  local problems=0

  check() { # check <description> <test-result>
    if [[ $2 == ok ]]; then
      printf '  ok    %s\n' "$1"
    else
      printf '  FAIL  %s\n' "$1"
      problems=$((problems + 1))
    fi
  }

  present() { [[ -e $1 ]] && echo ok || echo no; }
  contains() { grep -q "$2" "$1" 2>/dev/null && echo ok || echo no; }

  echo "user side:"
  check "omarchy-wwan on PATH" "$(command -v omarchy-wwan >/dev/null && echo ok || echo no)"
  check "omarchy-launch-wwan on PATH" "$(command -v omarchy-launch-wwan >/dev/null && echo ok || echo no)"
  check "config $CONFIG" "$(present "$CONFIG")"
  check "shell plugin installed" "$(present "$PLUGIN_DIR/manifest.json")"

  # The widget only shows up if the user's shell.json places it in a bar
  # section. `omarchy refresh shell` resets that file to stock, which is
  # exactly the kind of quiet loss this check exists to catch.
  local in_bar=no
  jq -e '[.bar.layout[]?[]? | select(.id == "erruviel.wwan")] | length > 0' \
    "$HOME/.config/omarchy/shell.json" >/dev/null 2>&1 && in_bar=ok
  check "widget in the bar layout" "$in_bar"

  check "menu entries" "$(contains "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc" 'omarchy-wwan')"
  check "post-update hook" "$(present "$HOME/.config/omarchy/hooks/post-update.d/omarchy-wwan")"

  echo "system side:"
  check "helper installed" "$(present /usr/local/bin/omarchy-wwan-helper)"
  # /etc/polkit-1/rules.d is mode 750, so a normal user cannot even stat the
  # file. Probe the outcome instead — that also proves the rule actually loaded
  # rather than merely existing.
  local polkit_ok=no
  if command -v pkcheck >/dev/null; then
    pkcheck --action-id org.freedesktop.ModemManager1.Control --process $$ >/dev/null 2>&1 &&
      polkit_ok=ok
  elif [[ -r /etc/polkit-1/rules.d/50-omarchy-wwan.rules ]]; then
    polkit_ok=ok
  fi
  check "polkit rule active (no password prompts)" "$polkit_ok"
  check "networkd drop-in" "$(present "$DROPIN")"
  check "unit known to systemd" "$(systemctl cat "$UNIT" >/dev/null 2>&1 && echo ok || echo no)"

  # An unreadable drop-in makes networkd discard the whole .network file.
  local grp
  grp=$(stat -c '%G' "$DROPIN" 2>/dev/null)
  check "drop-in readable by systemd-network" \
    "$([[ $grp == systemd-network ]] && echo ok || echo no)"

  echo "config:"
  check "provider database" \
    "$(command -v omarchy-wwan-providers >/dev/null && echo ok || echo no)"

  # A config/hardware mismatch is not broken yet, but the next connect will
  # switch slots and drop whatever is running now — worth saying out loud.
  local want_slot cur_slot idx
  want_slot=$(get_cfg SIM_SLOT)
  idx=$(modem_index)
  [[ -n $idx ]] && cur_slot=$(kv "$(mmcli -m "$idx" -K 2>/dev/null)" modem.generic.primary-sim-slot)
  if [[ -n $want_slot && -n ${cur_slot:-} && $want_slot != "$cur_slot" ]]; then
    check "SIM slot: config wants $want_slot, modem is on $cur_slot (next connect will switch)" no
  else
    check "SIM slot matches the config" ok
  fi

  if ((problems)); then
    echo
    echo "$problems item(s) need attention."
    echo "Anything missing or clobbered is restored by re-running the installer:"
    echo "    $REPO_HINT/install.sh"
    echo "Settings mismatches are yours to decide — edit $CONFIG."
    return 1
  fi
  echo
  echo "All good."
  return 0
}

case "${1:-status}" in
status) cmd_status ;;
doctor) cmd_doctor ;;
json | waybar) cmd_json ;;
panel) cmd_panel "${2:-}" ;;
present) wwan_hw_present ;;
notify-status) cmd_notify_status ;;
apn-input) cmd_apn_input ;;
connect | up) cmd_connect ;;
disconnect | down) cmd_disconnect ;;
toggle) cmd_toggle ;;
restart) systemctl restart "$UNIT" ;;
sim) cmd_sim "${2:-}" ;;
apn)
  [[ -n ${2:-} ]] || {
    echo "usage: omarchy-wwan apn <name>" >&2
    exit 2
  }
  set_cfg APN "$2"
  echo "APN set to $2. Run 'omarchy-wwan apply' to activate it."
  ;;
apply)
  require_system_half || exit 1
  systemctl restart "$UNIT"
  ;;
carrier) cmd_carrier "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
limit) cmd_limit "${2:-}" "${3:-}" ;;
limit-input) cmd_limit_input ;;
autoconnect) cmd_autoconnect "${2:-}" ;;
log) journalctl -u "$UNIT" -n 50 --no-pager ;;
config) "${EDITOR:-nano}" "$CONFIG" ;;
*)
  cat >&2 <<'EOF'
usage: omarchy-wwan <command>

  status              show modem/connection state (default)
  connect|disconnect  bring mobile data up or down
  toggle              connect if down, disconnect if up
  restart             reconnect
  apply               re-read wwan.conf and reconnect
  sim [1|2]           select physical SIM (1) or eSIM (2); bare: show config
  carrier ...         pick country/carrier and apply its APN (see: carrier)
  limit ...           monthly/daily data cap with auto-cutoff (see: limit)
  apn <name>          set the APN by hand
  autoconnect on|off  connect automatically at boot
  log                 recent connection log
  doctor              verify the patch is still fully in place
  config              edit ~/.config/omarchy/wwan.conf
  present             exit 0 if WWAN hardware is present (menu visibility)
  json                JSON status feed (waybar format)
  panel               key=value status feed for the shell panel
EOF
  exit 2
  ;;
esac
