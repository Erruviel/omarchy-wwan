#!/bin/bash
# Installed to ~/.config/omarchy/hooks/post-update.d/omarchy-wwan
#
# `omarchy update` can quietly undo parts of this patch — an `omarchy refresh
# shell` resets shell.json and drops the widget from the bar, and a refreshed
# extensions file loses the menu entries. Check after every update and say so,
# rather than letting the user discover it when the icon is gone.

command -v omarchy-wwan >/dev/null || exit 0

if ! report=$(omarchy-wwan doctor 2>&1); then
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send -g "󰢿" -u critical \
      "Mobile data patch needs attention" "$report"
  else
    notify-send -u critical "Mobile data patch needs attention" "$report"
  fi
fi
